        {
          "name": "Transaction History - Semua",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/transaction/history",
              "host": ["{{base_url}}"],
              "path": ["transaction", "history"]
            },
            "description": "Ambil semua history transaksi (tanpa limit)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Records adalah array', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(0);",
                  "    pm.expect(json.data.records).to.be.an('array');",
                  "});"
                ],
