        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@nutech-integrasi.com\",\n  \"password\": \"abcdef1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            },
            "description": "Login dan dapatkan JWT token (berlaku 12 jam)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.environment.set(\"TOKEN\", pm.response.json().data.token);",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Token tersedia', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(0);",
                  "    pm.expect(json.data.token).to.be.a('string');",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "    console.log('Token disimpan:', json.data.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
