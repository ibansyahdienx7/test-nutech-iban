        },
        {
          "name": "Transaction History - Dengan Limit & Offset",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/transaction/history?offset=0&limit=5",
              "host": ["{{base_url}}"],
              "path": ["transaction", "history"],
              "query": [
                { "key": "offset", "value": "0" },
                { "key": "limit",  "value": "5" }
              ]
            },
            "description": "History transaksi dengan pagination (offset=0, limit=5)."
          }
